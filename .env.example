# Copy to .env (cp .env.example .env). Every value below is a working local default.
# Variables are added here by the feature that starts reading them.

# --- API (apps/api, validated in src/config/env.ts) ---
# Interface and port the API listens on.
API_HOST=0.0.0.0
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true = human-readable logs; false = JSON lines for log aggregation.
LOG_PRETTY=true
# Development database (docker-compose `db` service).
DATABASE_URL=postgresql://chirp:chirp@localhost:5433/chirp
# Database used by the test suite; it is truncated between tests, so its name must end in _test.
TEST_DATABASE_URL=postgresql://chirp:chirp@localhost:5433/chirp_test
# Session lifetime in days; renewed while the user stays active (sliding expiration).
SESSION_TTL_DAYS=30
# true behind HTTPS, so the session cookie is never sent over plain HTTP.
COOKIE_SECURE=false
# Browser origins allowed to make state-changing requests (comma-separated).
WEB_ORIGINS=http://localhost:5173
# true only behind a reverse proxy (client IP comes from X-Forwarded-For).
TRUST_PROXY=false
# Requests per minute per IP on every route / attempts per minute on sign-in and sign-up.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
# S3-compatible object storage used for images (docker-compose `storage` service).
# Endpoints and credentials are required (no defaults in env.ts), so a deploy cannot
# silently fall back to these local values.
# The API calls S3_ENDPOINT (http://storage:9000 inside Docker); the browser uses S3_PUBLIC_ENDPOINT.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chirp-media
# Locally these are STORAGE_ROOT_USER / STORAGE_ROOT_PASSWORD below.
S3_ACCESS_KEY_ID=chirp
S3_SECRET_ACCESS_KEY=chirpsecret
# true for local S3-compatible servers (http://host/bucket/key); false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Largest image accepted for upload, in bytes (at most 5 MB, the limit shared with the web app).
UPLOAD_MAX_BYTES=5242880

# --- Local infrastructure (docker-compose.yml) ---
# Fixes container, network and volume names regardless of the folder name.
COMPOSE_PROJECT_NAME=chirp

# PostgreSQL. Host port 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_USER=chirp
POSTGRES_PASSWORD=chirp
POSTGRES_DB=chirp
POSTGRES_PORT=5433

# S3-compatible object storage (RustFS). Console: http://localhost:9001
STORAGE_ROOT_USER=chirp
STORAGE_ROOT_PASSWORD=chirpsecret
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_BUCKET=chirp-media
# Web origins allowed to upload with presigned URLs (dev server, Docker web).
STORAGE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
