// Data model: docs/ARCHITECTURE.md §4. Tables are introduced by the feature
// that needs them (ADR-21); never edit a migration once it is committed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Stored lowercase so a plain unique index is case-insensitive (ADR-18).
  email        String   @unique
  username     String   @unique @db.VarChar(15)
  displayName  String   @map("display_name") @db.VarChar(50)
  bio          String   @default("") @db.VarChar(160)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  // SHA-256 of the session token; the raw token only ever lives in the cookie (ADR-09).
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
