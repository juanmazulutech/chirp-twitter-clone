// Data model: docs/ARCHITECTURE.md §4. Tables are introduced by the feature
// that needs them (ADR-21); never edit a migration once it is committed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Stored lowercase so a plain unique index is case-insensitive (ADR-18).
  email        String   @unique
  username     String   @unique @db.VarChar(15)
  displayName  String   @map("display_name") @db.VarChar(50)
  bio          String   @default("") @db.VarChar(160)
  // Object key of the uploaded profile picture (ADR-14); null shows initials.
  avatarKey    String?  @map("avatar_key")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  tweets             Tweet[]
  likes              Like[]
  // Follows where this user is the follower, and where they are the one followed.
  following          Follow[]       @relation("FollowFollower")
  followers          Follow[]       @relation("FollowFollowing")
  // Notifications this user receives, and those their own actions caused (ADR-15).
  notifications      Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")

  // Trigram indexes serve case-insensitive substring search (ILIKE '%q%') on both names. The
  // migration enables `pg_trgm` first: Prisma does not manage extensions (ADR-04).
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_username_trgm_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_display_name_trgm_idx")
  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  // SHA-256 of the session token; the raw token only ever lives in the cookie (ADR-09).
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Tweet {
  id        String   @id @default(uuid(7)) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  // varchar(n) counts code points in PostgreSQL, matching `countCharacters` in @chirp/shared.
  content   String   @db.VarChar(280)
  // Object key of an attached image (ADR-14); unique, so deleting one chirp never removes
  // another chirp's image.
  imageKey  String?  @unique @map("image_key")
  // The chirp this one replies to; null for a top-level chirp (ADR-24).
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Deleting a chirp deletes the conversation under it (ADR-24).
  parent        Tweet?         @relation("TweetReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Tweet[]        @relation("TweetReplies")
  likes         Like[]
  // LIKE notifications point at the liked chirp; REPLY notifications at the reply itself.
  notifications Notification[]

  // Serves profile tweets and the home timeline's keyset pagination (ADR-11, ADR-12).
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  // Serves a chirp's replies, oldest first, and its reply count.
  @@index([parentId, createdAt, id])
  @@map("tweets")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  // The migration adds CHECK (follower_id <> following_id): Prisma cannot express it.

  // The primary key serves "whom does X follow" (timeline); this index serves follower lists and counts.
  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("follows")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  tweetId   String   @map("tweet_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  // The primary key serves "did the viewer like this" (likedByMe); this index serves like counts (ADR-13).
  @@id([userId, tweetId])
  @@index([tweetId])
  @@map("likes")
}

enum NotificationType {
  FOLLOW
  LIKE
  REPLY
}

// Created and deleted in the same transaction as the action that causes it (ADR-15).
model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  type        NotificationType
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  // FOLLOW: null. LIKE: the liked chirp. REPLY: the reply.
  tweetId     String?          @map("tweet_id") @db.Uuid
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  tweet     Tweet? @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  // One notification per action. The migration adds NULLS NOT DISTINCT (Prisma cannot express
  // it), so FOLLOW rows, whose tweet_id is null, are unique per pair of users too (ADR-15).
  @@unique([type, recipientId, actorId, tweetId], map: "notifications_action_key")
  // Serves the newest-first list and its keyset pagination.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  // Serves the unread count.
  @@index([recipientId, readAt])
  @@map("notifications")
}
