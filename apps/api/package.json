    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@chirp/shared": "*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7"
  }
}
