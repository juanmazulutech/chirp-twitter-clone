{
  "name": "chirp",
  "version": "0.1.0",
  "private": true,
  "description": "A Twitter/X clone: Fastify + Prisma + PostgreSQL API with a React + Vite web client.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "prepare": "husky",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "services:up": "docker compose up -d db storage storage-init",
    "services:down": "docker compose down",
    "db:generate": "npm run db:generate -w @chirp/api",
    "db:migrate": "npm run db:migrate -w @chirp/api",
    "db:seed": "npm run db:seed -w @chirp/api"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
