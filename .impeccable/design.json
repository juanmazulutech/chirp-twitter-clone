  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action on a screen (\"Chirp\"): an airmail red pill. Hover and pressed states are not built yet.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Chirp</button>",
      "css": ":host{color-scheme:light dark;--paper:light-dark(#f6f8fc,#0c1630);--sheet:light-dark(#ffffff,#121f40);--ink:light-dark(#14254a,#eef2fb);--ink-muted:light-dark(#4f5d7e,#a7b3cf);--hairline:light-dark(#dbe2ef,#26365e);--airmail-red:light-dark(#c81e3a,#ff6b7d);--on-airmail-red:light-dark(#ffffff,#2a0610);--airmail-blue:light-dark(#2452b8,#8bb0ff);--avatar-1:#2f7563;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;} .ds-btn-primary{display:inline-flex;align-items:center;height:48px;padding:0 20px;border:none;border-radius:9999px;background:var(--airmail-red);color:var(--on-airmail-red);font:600 1rem/1.5rem 'Archivo Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;} .ds-btn-primary:focus-visible{outline:2px solid var(--airmail-blue);outline-offset:2px;}"
    },
    {
      "name": "Link",
      "kind": "custom",
      "refersTo": "link",
      "description": "Inline links in airmail blue, underlined.",
      "html": "<a class=\"ds-link\" href=\"#\">A link in airmail blue</a>",
      "css": ":host{color-scheme:light dark;--paper:light-dark(#f6f8fc,#0c1630);--sheet:light-dark(#ffffff,#121f40);--ink:light-dark(#14254a,#eef2fb);--ink-muted:light-dark(#4f5d7e,#a7b3cf);--hairline:light-dark(#dbe2ef,#26365e);--airmail-red:light-dark(#c81e3a,#ff6b7d);--on-airmail-red:light-dark(#ffffff,#2a0610);--airmail-blue:light-dark(#2452b8,#8bb0ff);--avatar-1:#2f7563;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;} .ds-link{color:var(--airmail-blue);font-weight:500;text-decoration:underline;text-underline-offset:0.2em;} .ds-link:focus-visible{outline:2px solid var(--airmail-blue);outline-offset:2px;}"
    },
    {
      "name": "Header with chevron edge",
      "kind": "nav",
      "refersTo": "header",
      "description": "56px sheet header with the wordmark and the page's one airmail chevron hairline beneath it.",
      "html": "<header class=\"ds-header\"><div class=\"ds-header-bar\"><span class=\"ds-wordmark\">Chirp</span></div><div class=\"ds-airmail-edge\"></div></header>",
      "css": ":host{color-scheme:light dark;--paper:light-dark(#f6f8fc,#0c1630);--sheet:light-dark(#ffffff,#121f40);--ink:light-dark(#14254a,#eef2fb);--ink-muted:light-dark(#4f5d7e,#a7b3cf);--hairline:light-dark(#dbe2ef,#26365e);--airmail-red:light-dark(#c81e3a,#ff6b7d);--on-airmail-red:light-dark(#ffffff,#2a0610);--airmail-blue:light-dark(#2452b8,#8bb0ff);--avatar-1:#2f7563;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;} .ds-header{background:var(--sheet);color:var(--ink);} .ds-header-bar{display:flex;align-items:center;height:56px;padding:0 16px;} .ds-wordmark{font-size:1.25rem;line-height:1.75rem;font-weight:700;letter-spacing:-0.02em;} .ds-airmail-edge{height:4px;background:repeating-linear-gradient(135deg,var(--airmail-red) 0 10px,var(--sheet) 10px 16px,var(--airmail-blue) 16px 26px,var(--sheet) 26px 32px);}"
    },
    {
      "name": "Postmark",
      "kind": "custom",
      "refersTo": "postmark",
      "description": "Signature: every chirp is stamped with its time, day first, 24-hour, tilted -6deg; the full date is in a visually hidden label inside <time datetime>.",
      "html": "<time class=\"ds-postmark\" datetime=\"2026-11-21T21:42:00.000Z\" title=\"November 21, 2026 at 9:42 PM\"><span class=\"ds-sr-only\">November 21, 2026 at 9:42 PM</span><span aria-hidden=\"true\">21 NOV</span><span aria-hidden=\"true\" class=\"ds-postmark-time\">21:42</span><span aria-hidden=\"true\">CHIRP</span></time>",
      "css": ":host{color-scheme:light dark;--paper:light-dark(#f6f8fc,#0c1630);--sheet:light-dark(#ffffff,#121f40);--ink:light-dark(#14254a,#eef2fb);--ink-muted:light-dark(#4f5d7e,#a7b3cf);--hairline:light-dark(#dbe2ef,#26365e);--airmail-red:light-dark(#c81e3a,#ff6b7d);--on-airmail-red:light-dark(#ffffff,#2a0610);--airmail-blue:light-dark(#2452b8,#8bb0ff);--avatar-1:#2f7563;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;} .ds-postmark{display:inline-grid;place-content:center;width:56px;height:56px;flex-shrink:0;transform:rotate(-6deg);border:1.5px solid var(--airmail-blue);border-radius:9999px;color:var(--airmail-blue);text-align:center;font-size:0.5625rem;line-height:0.6875rem;font-weight:600;letter-spacing:0.04em;font-variant-numeric:tabular-nums;} .ds-postmark-time{font-size:0.75rem;line-height:1rem;} .ds-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}"
    },
    {
      "name": "Avatar fallback",
      "kind": "custom",
      "refersTo": "avatar-fallback",
      "description": "44px circle with white initials on one of six fixed avatar hues derived from the user id.",
      "html": "<span class=\"ds-avatar\" aria-hidden=\"true\">AT</span>",
      "css": ":host{color-scheme:light dark;--paper:light-dark(#f6f8fc,#0c1630);--sheet:light-dark(#ffffff,#121f40);--ink:light-dark(#14254a,#eef2fb);--ink-muted:light-dark(#4f5d7e,#a7b3cf);--hairline:light-dark(#dbe2ef,#26365e);--airmail-red:light-dark(#c81e3a,#ff6b7d);--on-airmail-red:light-dark(#ffffff,#2a0610);--airmail-blue:light-dark(#2452b8,#8bb0ff);--avatar-1:#2f7563;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;} .ds-avatar{display:grid;place-content:center;width:44px;height:44px;border-radius:9999px;background:var(--avatar-1);color:#ffffff;font-weight:600;}"
    },
    {
      "name": "Chirp row",
      "kind": "card",
      "refersTo": "chirp-row",
      "description": "Full-bleed feed row on the sheet: avatar, name and handle, text, tabular count, postmark top right; hairline below. Never a card.",
      "html": "<ol class=\"ds-feed\"><li class=\"ds-chirp\"><span class=\"ds-chirp-avatar\" aria-hidden=\"true\">AT</span><div class=\"ds-chirp-body\"><p class=\"ds-chirp-meta\"><span class=\"ds-chirp-name\">Ana Torres</span> <span class=\"ds-chirp-handle\">@ana_codes</span></p><p class=\"ds-chirp-text\">Shipped keyboard focus styles for the whole design system today. Tab through it and tell me what breaks.</p><p class=\"ds-chirp-count\">12 likes</p></div><time class=\"ds-chirp-postmark\" datetime=\"2026-11-21T21:42:00.000Z\"><span class=\"ds-sr-only\">November 21, 2026 at 9:42 PM</span><span aria-hidden=\"true\">21 NOV</span><span aria-hidden=\"true\" class=\"ds-chirp-postmark-time\">21:42</span><span aria-hidden=\"true\">CHIRP</span></time></li></ol>",
      "css": ":host{color-scheme:light dark;--paper:light-dark(#f6f8fc,#0c1630);--sheet:light-dark(#ffffff,#121f40);--ink:light-dark(#14254a,#eef2fb);--ink-muted:light-dark(#4f5d7e,#a7b3cf);--hairline:light-dark(#dbe2ef,#26365e);--airmail-red:light-dark(#c81e3a,#ff6b7d);--on-airmail-red:light-dark(#ffffff,#2a0610);--airmail-blue:light-dark(#2452b8,#8bb0ff);--avatar-1:#2f7563;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;} .ds-feed{list-style:none;margin:0;padding:0;background:var(--sheet);color:var(--ink);} .ds-chirp{position:relative;display:grid;grid-template-columns:2.75rem 1fr;gap:12px;padding:12px 16px;border-bottom:1px solid var(--hairline);} .ds-chirp:last-child{border-bottom:0;} .ds-chirp-avatar{display:grid;place-content:center;width:44px;height:44px;border-radius:9999px;background:var(--avatar-1);color:#fff;font-weight:600;} .ds-chirp-body{padding-right:64px;} .ds-chirp-body p{margin:0;} .ds-chirp-meta{font-size:0.875rem;line-height:1.25rem;} .ds-chirp-name{font-weight:600;} .ds-chirp-handle{color:var(--ink-muted);} .ds-chirp-text{margin-top:4px !important;font-size:0.9375rem;line-height:1.25rem;} .ds-chirp-count{margin-top:8px !important;font-size:0.875rem;line-height:1.25rem;color:var(--ink-muted);font-variant-numeric:tabular-nums;} .ds-chirp-postmark{position:absolute;top:10px;right:14px;display:inline-grid;place-content:center;width:56px;height:56px;transform:rotate(-6deg);border:1.5px solid var(--airmail-blue);border-radius:9999px;color:var(--airmail-blue);text-align:center;font-size:0.5625rem;line-height:0.6875rem;font-weight:600;letter-spacing:0.04em;font-variant-numeric:tabular-nums;} .ds-chirp-postmark-time{font-size:0.75rem;line-height:1rem;} .ds-sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;}"
    }
  ],
  "narrative": {
    "northStar": "Postmarked",
    "overview": "Every chirp is a letter from someone you chose, stamped with the moment it was sent. The world borrows from airmail correspondence: a blue-tinted paper ground, navy ink, the red-and-blue chevron of an airmail envelope, and a round postmark that carries each chirp's time. By night the envelope turns over: a navy ground with paper-tinted ink, the same red and blue lifted so they still pass AA.\n\nChirp runs in Operate mode. The world lends type, palette, density and one signature move; layout, navigation and controls stay the familiar social-app ones (timeline, composer, profile, follow lists), so nobody needs onboarding. Calm comes from restraint: flat sheets separated by hairlines, one accent per job, and absolute time instead of a ticking \"2m\".\n\nThe surface is dense in the way a phone feed must be (a 44px avatar, 15px body, 12px row padding) but never crowded; the postmark is the only ornament inside a chirp, and the chevron is the only ornament on the page.",
    "keyCharacteristics": [
      "Airmail paper and navy ink by day, a navy envelope by night, both following `prefers-color-scheme` through `light-dark()`.",
      "Airmail red for the one primary action and the liked state; airmail blue for links, selection, focus and the postmark ring.",
      "One chevron hairline, under the header, and nowhere else.",
      "Flat: hairline dividers, no decorative shadows.",
      "Archivo Variable throughout, tabular figures wherever numbers sit.",
      "Every chirp carries a postmark: day first, 24-hour time, tilted about 6°."
    ],
    "rules": [
      {
        "name": "The Red Letter Rule",
        "body": "Airmail red marks the one primary action and the liked state, nothing else. If a second red element appears on a screen, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Blue Pen Rule",
        "body": "Airmail blue means \"you can go here or you are here\": links, selection, focus and the postmark. It never fills a button.",
        "section": "colors"
      },
      {
        "name": "The Not By Colour Alone Rule",
        "body": "No state is carried by colour alone: a liked chirp changes its icon and its accessible state as well as turning red; errors carry words.",
        "section": "colors"
      },
      {
        "name": "The AA Both Ways Rule",
        "body": "Every foreground/background pair passes WCAG AA in both themes. A new token ships with its day and night ratios checked, not just its day one.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Wherever digits sit (times, counts, dates) they use tabular figures, so columns of numbers and the postmark do not jitter.",
        "section": "typography"
      },
      {
        "name": "The One Family Rule",
        "body": "Archivo Variable is the only typeface. Hierarchy comes from size, weight and tracking, never from a second display face.",
        "section": "typography"
      },
      {
        "name": "The Full Bleed Feed Rule",
        "body": "Feed rows run edge to edge on the sheet and are separated by hairlines. They are never cards, and never cards inside cards.",
        "section": "layout"
      },
      {
        "name": "The Hairline Rule",
        "body": "Structure comes from hairlines and the paper/sheet step. Decorative shadows are not part of this world; if something needs to float (a menu, a dialog), it earns elevation from its behaviour, and that elevation will be added to this file when it is built.",
        "section": "elevation"
      },
      {
        "name": "The One Chevron Rule",
        "body": "Exactly one chevron hairline per page, under the header. It is the page's only edging; it never frames cards, buttons or dialogs.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** define every new colour as a `light-dark()` pair on `:root` and map it through `@theme inline`, then check its AA ratio in both themes.",
      "**Do** keep airmail red to the one primary action and the liked state.",
      "**Do** use airmail blue for links, selection, focus and the postmark ring.",
      "**Do** separate feed rows with 1px hairlines on the sheet, full bleed.",
      "**Do** use tabular figures for every time, count and date.",
      "**Do** postmark chirps day first (\"21 NOV\") with 24-hour time, and expose the full date to assistive technology inside `<time datetime>`.",
      "**Do** pair every colour-coded state with an icon change, text or `aria-pressed`.",
      "**Do** let `prefers-reduced-motion` reduce every animation and transition to effectively zero."
    ],
    "donts": [
      "**Don't** add a second chevron edge or use the chevron as a frame; there is exactly one, under the header.",
      "**Don't** use decorative shadows; depth is paper, sheet and hairline.",
      "**Don't** wrap feed rows in cards, or nest cards inside cards.",
      "**Don't** fill buttons with airmail blue or use red for anything but the primary action and the liked state.",
      "**Don't** carry a state by colour alone.",
      "**Don't** replace the postmark with relative \"2m\" labels as the only sense of time.",
      "**Don't** introduce a second typeface.",
      "**Don't** use X's name, bird mark or brand blue."
    ]
  }
}
